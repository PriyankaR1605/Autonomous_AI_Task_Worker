# LLM API Keys (Supports Gemini, OpenAI, Anthropic, or Local Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Model Selection
DEFAULT_MODEL=gemini/gemini-1.5-flash
# Alternative examples:
# DEFAULT_MODEL=openai/gpt-4o-mini
# DEFAULT_MODEL=anthropic/claude-3-5-sonnet-20241022
# DEFAULT_MODEL=ollama/llama3.1

# Mock ERP Configuration
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_PORT=8000
MOCK_ERP_BASE_URL=http://127.0.0.1:8000
ERP_ADMIN_USER=admin
ERP_ADMIN_PASS=company_secure_pass

# Agent Settings
HEADLESS_BROWSER=false
MAX_AGENT_STEPS=15
HIGH_RISK_AMOUNT_THRESHOLD=3000.00
