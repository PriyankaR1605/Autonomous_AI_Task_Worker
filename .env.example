# LLM API Keys (Supports Gemini)
GEMINI_API_KEY=


# Default Model Selection
DEFAULT_MODEL=gemini/gemini-3.5-flash

# Cloud & Public Deployment URLs
PUBLIC_BASE_URL=https://autonomous-ai-task-worker.onrender.com

# Mock ERP Configuration
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_PORT=8000
MOCK_ERP_BASE_URL=http://127.0.0.1:8000
ERP_ADMIN_USER=admin
ERP_ADMIN_PASS=company_secure_pass

# Agent Settings
HEADLESS_BROWSER=false
MAX_AGENT_STEPS=15
HIGH_RISK_AMOUNT_THRESHOLD=3000.00
STEP_DELAY_SECONDS=1.5
